// butterfly.wyv — a radix-2 FFT butterfly with a twiddle factor.
//
// transpose.wyv showed data movement (shuffle); this shows the rest of @simd:
// lane arithmetic and scalar broadcast. A twiddled radix-2 butterfly is
// `out_lo = in_lo + w*in_hi; out_hi = in_lo - w*in_hi`, a whole vector at a
// time. The scalar twiddle `w` multiplies a vector — wyvec broadcasts it
// (insertelement + splat shuffle, → vbroadcastss). @effect, @noalias, and
// every vector width are still checked.
//
// shuffle + lane arithmetic + broadcast are the three moving parts of an
// FFT; a full transform composes butterflies and bit-reversal permutations
// from exactly these.

@interface Butterfly

@effect(reads(a), writes(b))
@simd
+ (void)bfly:(float)w
           a:(@noalias const float *)a
           b:(@noalias float *)b;

@end

@implementation Butterfly

+ (void)bfly:(float)w
           a:(@noalias const float *)a
           b:(@noalias float *)b
{
    float4 lo = a[0 : 4];
    float4 hi = a[4 : 4];
    float4 t  = w * hi;       // scalar w broadcast across the vector
    float4 sum = lo + t;
    float4 dif = lo - t;
    b[0 : 4] = sum;
    b[4 : 4] = dif;
}

@end
