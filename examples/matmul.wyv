// matmul.wyv — the schedule lives in the contract, not in the loops.
//
// Both kernels below have the IDENTICAL naive triple loop. The only
// difference is one contract line: @tile(i: 64, j: 64). wyvec proves the
// tiling legal (c is write-only with an injective row-major store; i and
// j are parallel) and performs strip-mine + interchange itself, above
// LLVM — LLVM's -O2 pipeline does not tile loops at all.
//
// Tiling parallel loops is float-exact: every c[i*n + j] is computed in
// the same order as the naive version, only visited in a cache-friendly
// order.

@interface Gemm

@effect(reads(a, b), writes(c))
@tile(i: 64, j: 64)
+ (void)matmul:(@noalias const float *)a
             b:(@noalias const float *)b
             c:(@noalias float *)c
             m:(usize)m
             n:(usize)n
             k:(usize)k;

@end

@implementation Gemm

+ (void)matmul:(@noalias const float *)a
             b:(@noalias const float *)b
             c:(@noalias float *)c
             m:(usize)m
             n:(usize)n
             k:(usize)k
{
    for (usize i = 0; i < m; i++) {
        for (usize j = 0; j < n; j++) {
            float acc = 0.0f;
            for (usize p = 0; p < k; p++) {
                acc += a[i * k + p] * b[p * n + j];
            }
            c[i * n + j] = acc;
        }
    }
}

@end

// the ikj schedule: @interchange(p, j) hoists the reduction loop over j
// (scalar expansion + interchange, proven float-exact). The inner loop
// then walks b and c sequentially — LLVM vectorizes it on its own.
@interface Ikj

@effect(reads(a, b), writes(c))
@interchange(p, j)
+ (void)matmul:(@noalias const float *)a
             b:(@noalias const float *)b
             c:(@noalias float *)c
             m:(usize)m
             n:(usize)n
             k:(usize)k;

@end

@implementation Ikj

+ (void)matmul:(@noalias const float *)a
             b:(@noalias const float *)b
             c:(@noalias float *)c
             m:(usize)m
             n:(usize)n
             k:(usize)k
{
    for (usize i = 0; i < m; i++) {
        for (usize j = 0; j < n; j++) {
            float acc = 0.0f;
            for (usize p = 0; p < k; p++) {
                acc += a[i * k + p] * b[p * n + j];
            }
            c[i * n + j] = acc;
        }
    }
}

@end

// the control group: same loops, no schedule
@interface Naive

@effect(reads(a, b), writes(c))
+ (void)matmul:(@noalias const float *)a
             b:(@noalias const float *)b
             c:(@noalias float *)c
             m:(usize)m
             n:(usize)n
             k:(usize)k;

@end

@implementation Naive

+ (void)matmul:(@noalias const float *)a
             b:(@noalias const float *)b
             c:(@noalias float *)c
             m:(usize)m
             n:(usize)n
             k:(usize)k
{
    for (usize i = 0; i < m; i++) {
        for (usize j = 0; j < n; j++) {
            float acc = 0.0f;
            for (usize p = 0; p < k; p++) {
                acc += a[i * k + p] * b[p * n + j];
            }
            c[i * n + j] = acc;
        }
    }
}

@end
