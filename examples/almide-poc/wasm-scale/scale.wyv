// scale.wyv — Wyve kernel that replaces Almide's almide_rt_matrix_scale.
// out[i] = a * x[i], proven in-range (@bounds), SIMD128 on wasm32.
@interface WyveScale

@effect(reads(x), writes(y))
@bounds(x: n, y: n)
@vectorize(require, width: 4)
+ (void)scale:(float)a
            x:(@noalias const float *)x
            y:(@noalias float *)y
        count:(usize)n;

@end

@implementation WyveScale

+ (void)scale:(float)a
            x:(@noalias const float *)x
            y:(@noalias float *)y
        count:(usize)n
{
    for (usize i = 0; i < n; i++) {
        y[i] = a * x[i];
    }
}

@end
