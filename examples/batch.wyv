// batch.wyv — @batch: write one signal naively, get the batched SIMD.
//
// fft-batch.wyv showed that batching a 4-point FFT over 8 signals
// (signal-major layout) eliminates the shuffles and runs ~9× faster — but
// it was hand-written in explicit float8s. @batch automates exactly that.
//
// Below is one signal's 4-point FFT in plain scalar code: `float` locals,
// `x[k]` loads at constant element indices, ordinary arithmetic. `@batch(8)`
// tells wyvec to lay the data out signal-major (element k of signal s at
// base[k*8 + s]) and widen every operation to a float8 across 8 signals. The
// combined elements then share a lane, so the emitted IR is **zero shuffles**
// — byte-for-similar to the hand-written batch, at the same speed
// (1.16 ns/transform), and verified exact against the DFT.
//
// This is the data-parallel contract, finishing the family alongside
// @vectorize / @interchange / @parallel: the human writes one signal, the
// compiler delivers the lane-parallel kernel.

@interface Batched

@effect(reads(x), writes(y))
@batch(8)
+ (void)fft:(@noalias const float *)x
           y:(@noalias float *)y;

@end

@implementation Batched

+ (void)fft:(@noalias const float *)x
           y:(@noalias float *)y
{
    float e0r = x[0] + x[2];        // stage 1: x0 ± x2, x1 ± x3
    float e0i = x[4] + x[6];
    float e1r = x[0] - x[2];
    float e1i = x[4] - x[6];
    float o0r = x[1] + x[3];
    float o0i = x[5] + x[7];
    float o1r = x[1] - x[3];
    float o1i = x[5] - x[7];

    float wr = o1i;                 // W·O1 = -i·O1 = (o1i, -o1r)
    float wi = -o1r;

    y[0] = e0r + o0r;               // X0
    y[2] = e0r - o0r;               // X2
    y[4] = e0i + o0i;
    y[6] = e0i - o0i;
    y[1] = e1r + wr;                // X1
    y[3] = e1r - wr;                // X3
    y[5] = e1i + wi;
    y[7] = e1i - wi;
}

@end

// @batch over a block loop: process N = 8*blocks signals in one call. Write
// the block loop and one block's FFT; wyvec widens the body to float8 and
// adds the per-block offset (block i's data at x + i*64, since one block is
// 8 elements × 8 signals). 32768 signals run at 1.3 ns/transform — 2.3×
// over the scalar loop, zero shuffles (bench/NOTES.md).
@interface Blocks

@effect(reads(x), writes(y))
@batch(8)
+ (void)fft:(@noalias const float *)x
           y:(@noalias float *)y
      blocks:(usize)b;

@end

@implementation Blocks

+ (void)fft:(@noalias const float *)x
           y:(@noalias float *)y
      blocks:(usize)b
{
    for (usize i = 0; i < b; i++) {
        float e0r = x[0] + x[2];
        float e0i = x[4] + x[6];
        float e1r = x[0] - x[2];
        float e1i = x[4] - x[6];
        float o0r = x[1] + x[3];
        float o0i = x[5] + x[7];
        float o1r = x[1] - x[3];
        float o1i = x[5] - x[7];
        float wr = o1i;
        float wi = -o1r;
        y[0] = e0r + o0r;
        y[2] = e0r - o0r;
        y[4] = e0i + o0i;
        y[6] = e0i - o0i;
        y[1] = e1r + wr;
        y[3] = e1r - wr;
        y[5] = e1i + wi;
        y[7] = e1i - wi;
    }
}

@end
