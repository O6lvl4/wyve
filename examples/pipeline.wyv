// pipeline.wyv — kernel-to-kernel calls, with the @noalias contract proven
// across the call boundary (stage 2).
//
// One kernel calls another with `[Interface label:arg …];`. Beyond the type
// check, wyvec proves the callee's @noalias holds at each call: every
// argument bound to an @noalias parameter must itself be @noalias here (so
// it can't alias the others), and no pointer may go to two @noalias
// parameters. That is why this pipeline threads a separate `tmp` buffer
// instead of scaling in place — passing `y` as both `x` and `y` of Scale
// would alias, and wyvec refuses it (see examples/invalid/alias-call.wyv).

@interface Scale

@effect(reads(x), writes(y))
+ (void)by:(float)a
          x:(@noalias const float *)x
          y:(@noalias float *)y
      count:(usize)n;

@end

@implementation Scale

+ (void)by:(float)a
          x:(@noalias const float *)x
          y:(@noalias float *)y
      count:(usize)n
{
    for (usize i = 0; i < n; i++) {
        y[i] = a * x[i];
    }
}

@end

// a two-stage pipeline: y = (x*2)*3, through a separate tmp buffer so every
// @noalias argument has a distinct, provably-non-aliasing source
@interface Pipeline

@effect(reads(x), writes(y))
+ (void)run:(@noalias const float *)x
          tmp:(@noalias float *)tmp
            y:(@noalias float *)y
        count:(usize)n;

@end

@implementation Pipeline

+ (void)run:(@noalias const float *)x
          tmp:(@noalias float *)tmp
            y:(@noalias float *)y
        count:(usize)n
{
    [Scale by:2.0f x:x y:tmp count:n];
    [Scale by:3.0f x:tmp y:y count:n];
}

@end
