// batch-sparse.wyv — MUST NOT COMPILE.
//
// A @batch kernel's element subscripts imply a per-block buffer of
// (max+1)*W floats — a size invisible in the contract. So it must at least be
// justified: the indices have to densely cover 0..max. Here x[0] and
// x[1000000] are used but everything between is never touched, implying a
// buffer of a million elements with gaps the kernel ignores:
//
//   error[WVN060]: @batch element indices are sparse: index 1000000 is used
//                  but 1 is never touched …
//
// This was the risk-review a3/r5 hole — a @batch kernel quietly demanding a
// huge, mostly-unused buffer. With the dense-subscript check it is a compile
// error, not a promised buffer size the caller can't see.

@interface Sparse

@effect(reads(x), writes(y))
@batch(8)
+ (void)f:(@noalias const float *)x
          y:(@noalias float *)y;

@end

@implementation Sparse

+ (void)f:(@noalias const float *)x
          y:(@noalias float *)y
{
    float a = x[0] + x[1000000];     // sparse: 1..999999 never touched
    y[0] = a;
}

@end
