// complex-mul.wyv — complex multiplication, now a single builtin.
//
// Two complex numbers laid out structure-of-arrays in a float4 —
// [re0 re1 im0 im1] — multiply with `cmul`, which expands to the shuffle +
// vector mul/add/sub network for (a+bi)(c+di) = (ac-bd) + (ad+bc)i. The
// builtin needs an even width (real then imaginary halves) and works on
// float2/4/8/16, multiplying the complex lanes pairwise.
//
// Verified: (1+2i)(3+4i) = -5+10i, (5+6i)(7+8i) = -13+82i.

@interface Complex

@effect(reads(a, b), writes(c))
@simd
+ (void)mul:(@noalias const float *)a
          b:(@noalias const float *)b
          c:(@noalias float *)c;

@end

@implementation Complex

+ (void)mul:(@noalias const float *)a
          b:(@noalias const float *)b
          c:(@noalias float *)c
{
    float4 x = a[0 : 4];
    float4 y = b[0 : 4];
    float4 r = cmul(x, y);
    c[0 : 4] = r;
}

@end
