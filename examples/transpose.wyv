// transpose.wyv — shuffle-shaped kernels: 4x4 and 8x8 float transpose.
//
// Auto-vectorization and @vectorize(manual) handle elementwise loops, but
// not data movement — transposes, FFT butterflies, AoS↔SoA. Those need
// explicit lanes. @simd gives them: vector locals (floatN), slice
// loads/stores (`a[off : N]`), and shuffle(a, b, lanes…) — which lowers to
// LLVM `shufflevector`. It is hand-written SIMD, but inside Wyve's checking:
// @effect, @noalias, slice lengths, and shuffle index ranges are all
// verified (WVN041).
//
// The classic 4x4 transpose: two unpack passes, then two 64-bit moves. 8x8
// is the same idea with three passes (24 shuffles), doubling the block size
// each pass. The 8x8 network is what @batch would need to turn AoS into
// signal-major layout — but measured at 48 shuffles round-trip it sinks a
// batched 4-point FFT below scalar (3.7 vs 2.9 ns/transform), so @batch
// keeps the SoA layout instead (docs/roadmap/active/batch-contract.md). The
// transpose is exact and useful on its own.

@interface Transpose

@effect(reads(a), writes(b))
@simd
+ (void)t4:(@noalias const float *)a
          b:(@noalias float *)b;

@effect(reads(a), writes(b))
@simd
+ (void)t8:(@noalias const float *)a
          b:(@noalias float *)b;

@end

@implementation Transpose

+ (void)t4:(@noalias const float *)a
          b:(@noalias float *)b
{
    float4 r0 = a[0 : 4];
    float4 r1 = a[4 : 4];
    float4 r2 = a[8 : 4];
    float4 r3 = a[12 : 4];

    // unpack low/high pairs
    float4 s0 = shuffle(r0, r1, 0, 4, 1, 5);
    float4 s1 = shuffle(r0, r1, 2, 6, 3, 7);
    float4 s2 = shuffle(r2, r3, 0, 4, 1, 5);
    float4 s3 = shuffle(r2, r3, 2, 6, 3, 7);

    // combine halves into transposed rows
    float4 c0 = shuffle(s0, s2, 0, 1, 4, 5);
    float4 c1 = shuffle(s0, s2, 2, 3, 6, 7);
    float4 c2 = shuffle(s1, s3, 0, 1, 4, 5);
    float4 c3 = shuffle(s1, s3, 2, 3, 6, 7);

    b[0 : 4] = c0;
    b[4 : 4] = c1;
    b[8 : 4] = c2;
    b[12 : 4] = c3;
}

+ (void)t8:(@noalias const float *)a
          b:(@noalias float *)b
{
    float8 r0 = a[0 : 8];
    float8 r1 = a[8 : 8];
    float8 r2 = a[16 : 8];
    float8 r3 = a[24 : 8];
    float8 r4 = a[32 : 8];
    float8 r5 = a[40 : 8];
    float8 r6 = a[48 : 8];
    float8 r7 = a[56 : 8];

    // pass 1 — interleave adjacent rows (block size 1 -> 2)
    float8 a0 = shuffle(r0, r1, 0, 8, 1, 9, 2, 10, 3, 11);
    float8 a1 = shuffle(r0, r1, 4, 12, 5, 13, 6, 14, 7, 15);
    float8 a2 = shuffle(r2, r3, 0, 8, 1, 9, 2, 10, 3, 11);
    float8 a3 = shuffle(r2, r3, 4, 12, 5, 13, 6, 14, 7, 15);
    float8 a4 = shuffle(r4, r5, 0, 8, 1, 9, 2, 10, 3, 11);
    float8 a5 = shuffle(r4, r5, 4, 12, 5, 13, 6, 14, 7, 15);
    float8 a6 = shuffle(r6, r7, 0, 8, 1, 9, 2, 10, 3, 11);
    float8 a7 = shuffle(r6, r7, 4, 12, 5, 13, 6, 14, 7, 15);

    // pass 2 — block size 2 -> 4
    float8 b0 = shuffle(a0, a2, 0, 1, 8, 9, 2, 3, 10, 11);
    float8 b1 = shuffle(a0, a2, 4, 5, 12, 13, 6, 7, 14, 15);
    float8 b2 = shuffle(a1, a3, 0, 1, 8, 9, 2, 3, 10, 11);
    float8 b3 = shuffle(a1, a3, 4, 5, 12, 13, 6, 7, 14, 15);
    float8 b4 = shuffle(a4, a6, 0, 1, 8, 9, 2, 3, 10, 11);
    float8 b5 = shuffle(a4, a6, 4, 5, 12, 13, 6, 7, 14, 15);
    float8 b6 = shuffle(a5, a7, 0, 1, 8, 9, 2, 3, 10, 11);
    float8 b7 = shuffle(a5, a7, 4, 5, 12, 13, 6, 7, 14, 15);

    // pass 3 — block size 4 -> 8, transposed rows out
    float8 c0 = shuffle(b0, b4, 0, 1, 2, 3, 8, 9, 10, 11);
    float8 c1 = shuffle(b0, b4, 4, 5, 6, 7, 12, 13, 14, 15);
    float8 c2 = shuffle(b1, b5, 0, 1, 2, 3, 8, 9, 10, 11);
    float8 c3 = shuffle(b1, b5, 4, 5, 6, 7, 12, 13, 14, 15);
    float8 c4 = shuffle(b2, b6, 0, 1, 2, 3, 8, 9, 10, 11);
    float8 c5 = shuffle(b2, b6, 4, 5, 6, 7, 12, 13, 14, 15);
    float8 c6 = shuffle(b3, b7, 0, 1, 2, 3, 8, 9, 10, 11);
    float8 c7 = shuffle(b3, b7, 4, 5, 6, 7, 12, 13, 14, 15);

    b[0 : 8] = c0;
    b[8 : 8] = c1;
    b[16 : 8] = c2;
    b[24 : 8] = c3;
    b[32 : 8] = c4;
    b[40 : 8] = c5;
    b[48 : 8] = c6;
    b[56 : 8] = c7;
}

@end
